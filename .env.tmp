RUNTIME_ROLE=all
RUN_DEPLOY_BOOTSTRAP=1
RUN_QUEUE_WORKER=1
RUN_REVERB=1
RUN_SCHEDULER=1
QUEUE_WORKER_QUEUES=document-processing,notifications,default,ai-processing
BOOTSTRAP_MIGRATE_MAX_ATTEMPTS=10
BOOTSTRAP_MIGRATE_SLEEP_SECONDS=5

