ARCHIVE_ENV_LABEL=local
ARCHIVE_ENABLE_INSTANCE_SWITCH=false
ARCHIVE_IT_MODE_ENABLED=false
ARCHIVE_IT_SUPPORT_PIN_HASH=
ARCHIVE_CLIENT_HEADER_NAME="X-ArchiveMaster-Client"
